# Anthropic API 키 (없으면 AI 추출은 자동으로 강도 버튼 폴백)
ANTHROPIC_API_KEY=
# 추출 모델 (PRD 기준 claude-haiku-4-5)
CLAUDE_MODEL=claude-haiku-4-5
# 사용자 식별자 해시 솔트 (반드시 변경)
USER_HASH_SALT=change-me-to-a-long-random-string
# 시연 모드: 애월읍 가상 좌표 토글 노출
DEMO_MODE=true
# SQLite 파일 경로
DB_PATH=data/jeju-breath.db
# 카카오 오픈빌더 스킬 URL 비밀값: 스킬 URL에 ?key=값 으로 붙인다
KAKAO_SKILL_SECRET=change-me
# 카톡 카드 버튼에 들어갈 공개 주소. 보통 비워 둔다: npm run tunnel이 data/public-url.txt에 자동 기록
PUBLIC_BASE_URL=
# 스킬 서버용 ngrok 고정 도메인 (npm run ngrok). 예: abc-def.ngrok-free.dev
NGROK_DOMAIN=
